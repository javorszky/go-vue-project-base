# EditorConfig — https://editorconfig.org
# Matches the output of the enforced formatters (gofumpt, Prettier).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Go: tabs, per gofmt
[*.go]
indent_style = tab

[Makefile]
indent_style = tab

# Frontend and config files: 2-space, per .prettierrc
[*.{ts,vue,js,json,css,html,yml,yaml}]
indent_size = 2
indent_style = space

[*.md]
# Trailing double-space is a hard line break in Markdown
trim_trailing_whitespace = false
