# Go
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
/bin/
/dist/
/server
vendor/

# Frontend
**/node_modules/
frontend/dist/
frontend/coverage/

# Go-embedded frontend build output — only .gitkeep is tracked so the
# `//go:embed all:dist` directive always has a directory to embed; run
# `npm run build` in frontend/ to populate it before the binary can serve the SPA
internal/ui/dist/*
!internal/ui/dist/.gitkeep
frontend/.env
frontend/.env.local
frontend/.env.*.local

# IDE / OS
.DS_Store
.idea/
*.swp
*.swo

# Claude Code — local settings are user-specific, not project-wide
.claude/settings.local.json
